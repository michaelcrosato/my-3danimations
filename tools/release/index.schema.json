{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "m3a registry index (library/index.json)",
  "description": "The registry index (PLAN.md WP-9.4): each core set's versions, immutable, yanked never deleted, and the community packs federated from namespaces verified to their owners. tools/release/index.ts writes it (npm run index); release.test.ts holds the committed index and an admitted pack to it.",
  "type": "object",
  "required": ["about", "format", "serial", "core", "community"],
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "yanked": { "type": "string", "minLength": 1, "description": "why the version (or set) is yanked: it stays listed" },
    "setVersion": {
      "type": "object",
      "required": ["v", "content", "digest", "title", "tier", "licenses", "clips", "bytes", "qa", "review"],
      "additionalProperties": false,
      "properties": {
        "v": { "type": "integer", "minimum": 1 },
        "content": { "$ref": "#/$defs/sha256" },
        "digest": { "$ref": "#/$defs/sha256" },
        "title": { "type": "string", "minLength": 1 },
        "tier": { "enum": ["cc0", "cc-by", "cmu", "local"] },
        "licenses": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "clips": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "qa": { "$ref": "#/$defs/counts" },
        "review": { "$ref": "#/$defs/counts" },
        "yanked": { "$ref": "#/$defs/yanked" }
      }
    },
    "packVersion": {
      "type": "object",
      "required": ["v", "content", "url", "license", "tier"],
      "additionalProperties": false,
      "properties": {
        "v": { "type": "integer", "minimum": 1 },
        "content": { "$ref": "#/$defs/sha256" },
        "url": { "type": "string", "pattern": "^https://" },
        "license": { "type": "string", "minLength": 1 },
        "tier": { "enum": ["cc0", "cc-by", "cmu", "local"] },
        "yanked": { "$ref": "#/$defs/yanked" }
      }
    }
  },
  "properties": {
    "about": { "type": "string" },
    "format": { "const": "1" },
    "serial": { "type": "integer", "minimum": 1 },
    "core": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["versions"],
        "additionalProperties": false,
        "properties": { "yanked": { "$ref": "#/$defs/yanked" }, "versions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/setVersion" } } }
      }
    },
    "community": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["namespace", "set", "versions"],
        "additionalProperties": false,
        "properties": {
          "namespace": { "type": "string", "minLength": 1 },
          "set": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "proof": { "type": "string" },
          "versions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/packVersion" } }
        }
      }
    }
  }
}

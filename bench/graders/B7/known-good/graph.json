{
 "format": "2.0",
 "id": "GRAPHS/B7",
 "parameters": {
  "speed": { "type": "number", "value": 0 },
  "grounded": { "type": "bool", "value": true },
  "jump": { "type": "trigger", "buffer": 0.1 }
 },
 "start": "idle",
 "states": {
  "idle": { "clip": "QUATERNIUS_3D2DGE/Idle_Loop" },
  "walk": { "clip": "QUATERNIUS_3D2DGE/Walk_Loop" },
  "run": { "clip": "QUATERNIUS_3D2DGE/Jog_Fwd_Loop" },
  "jump": { "clip": "QUATERNIUS_3D2DGE/Jump_Start" },
  "air": { "clip": "QUATERNIUS_3D2DGE/Jump_Loop" },
  "land": { "clip": "QUATERNIUS_3D2DGE/Jump_Land" }
 },
 "transitions": [
  { "from": ["idle", "walk", "run"], "to": "jump", "when": [{ "param": "jump" }, { "param": "grounded" }], "fade": 0.1 },
  { "from": ["idle", "walk"], "to": "run", "when": [{ "param": "speed", "op": ">=", "value": 2.2 }], "fade": 0.25, "sync": true },
  { "from": ["idle", "run"], "to": "walk", "when": [{ "param": "speed", "op": ">", "value": 0.2 }, { "param": "speed", "op": "<", "value": 2.2 }], "fade": 0.25, "sync": true },
  { "from": ["walk", "run"], "to": "idle", "when": [{ "param": "speed", "op": "<=", "value": 0.2 }], "fade": 0.3 },
  { "from": ["jump", "air"], "to": "land", "when": [{ "param": "grounded" }], "fade": 0.1 },
  { "from": "jump", "to": "air", "exit": 1, "fade": 0.15 },
  { "from": "land", "to": "run", "when": [{ "param": "speed", "op": ">=", "value": 2.2 }], "exit": 0.4, "fade": 0.25 },
  { "from": "land", "to": "walk", "when": [{ "param": "speed", "op": ">", "value": 0.2 }], "exit": 0.4, "fade": 0.25 },
  { "from": "land", "to": "idle", "exit": 0.9, "fade": 0.3 }
 ]
}

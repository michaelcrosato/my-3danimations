    "packages/tools"
  ],
  "scripts": {
    "check": "node tools/run/check.ts",
    "test": "node tools/run/test.ts",
    "e2e": "node tools/run/e2e.ts",
    "test:changed": "node tools/run/changed.ts",
    "test:cross-engine": "node tools/cross-engine/main.ts",
    "gate": "node tools/run/gate.ts",
    "doctrine": "node tools/doctrine/main.ts",
    "vectors": "node tools/vectors/main.ts",
    "pins": "node tools/pins/main.ts",
    "bench": "node bench/runner/main.ts",
    "migrate": "node tools/migrate/main.ts",
    "qa": "node tools/qa/main.ts",
    "plant": "node tools/plant/main.ts",
    "fixtures": "node tools/fixtures/main.ts",
    "sweep": "node tools/sweep/main.ts",
    "hello": "node tools/run/hello.ts",
    "library": "node tools/library/main.ts",
    "license": "node tools/license/main.ts",
    "corpora": "node tools/corpora/main.ts",
    "import": "node tools/import/main.ts",
    "facts": "node tools/facts/main.ts",
    "moves": "node tools/procedural/carry.ts",
    "sim": "node tools/sim/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "gpt-tokenizer": "4.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild": false

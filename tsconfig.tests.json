{
  "//": "Tests, repo tools, services (the intake's submit function, Deno-style: fetch types, no Deno API but its entry's own declaration) and configs: Node types allowed. The packages' own sources are checked by their projects.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": ".cache/tsc/tests",
    "rootDir": ".",
    "lib": ["es2023", "dom"],
    "types": ["node", "vite/client"]
  },
  "include": ["packages/*/test/**/*.ts", "packages/three/test-characters/**/*.ts", "tools/**/*.ts", "tests/**/*.ts", "spec/**/*.ts", "apps/**/*.ts", "bench/**/*.ts", "services/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", ".cache", "**/dist"],
  "references": [
    { "path": "packages/core" },
    { "path": "packages/sensors" },
    { "path": "packages/io" },
    { "path": "packages/library" },
    { "path": "packages/three" },
    { "path": "packages/tools" }
  ]
}
